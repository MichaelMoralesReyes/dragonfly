diff --git a/server/block/map_frame_verify_test.go b/server/block/map_frame_verify_test.go
new file mode 100644
index 0000000..4e09eae
--- /dev/null
+++ b/server/block/map_frame_verify_test.go
@@ -0,0 +1,120 @@
+package block_test
+
+import (
+	"bytes"
+	"context"
+	"image/color"
+	"testing"
+
+	"github.com/df-mc/dragonfly/server/block"
+	"github.com/df-mc/dragonfly/server/block/cube"
+	"github.com/df-mc/dragonfly/server/entity"
+	"github.com/df-mc/dragonfly/server/item"
+	"github.com/df-mc/dragonfly/server/world"
+	"github.com/sandertv/gophertunnel/minecraft/nbt"
+	"github.com/sandertv/gophertunnel/minecraft/protocol"
+	"github.com/sandertv/gophertunnel/minecraft/protocol/packet"
+)
+
+func mapFrame(id int64) block.ItemFrame {
+	return block.ItemFrame{Facing: cube.FaceNorth, Map: true, Item: item.NewStack(item.FilledMap{ID: id}, 1)}
+}
+
+func TestMapFrameRuntimeIDsDiffer(t *testing.T) {
+	world.DefaultBlockRegistry.Finalize()
+	plain := world.BlockRuntimeID(block.ItemFrame{Facing: cube.FaceNorth})
+	withMap := world.BlockRuntimeID(mapFrame(900001))
+	if plain == withMap {
+		t.Fatalf("map frame and plain frame share runtime id %d", plain)
+	}
+	b, ok := world.BlockByRuntimeID(withMap)
+	if !ok {
+		t.Fatal("runtime id not found")
+	}
+	_, props := b.EncodeBlock()
+	t.Logf("map frame state properties: %v", props)
+	if props["item_frame_map_bit"] != uint8(1) {
+		t.Fatalf("map bit = %v, want 1", props["item_frame_map_bit"])
+	}
+	pb, _ := world.BlockByRuntimeID(plain)
+	_, props = pb.EncodeBlock()
+	if props["item_frame_map_bit"] != uint8(0) {
+		t.Fatalf("plain map bit = %v, want 0", props["item_frame_map_bit"])
+	}
+	// every face/glow combination must resolve.
+	for _, f := range cube.Faces() {
+		for _, g := range []bool{true, false} {
+			world.BlockRuntimeID(block.ItemFrame{Facing: f, Glowing: g, Map: true})
+			world.BlockRuntimeID(block.ItemFrame{Facing: f, Glowing: g})
+		}
+	}
+}
+
+func TestMapFrameInWorldAndNBTDiskRoundTrip(t *testing.T) {
+	w := world.Config{Synchronous: true, Entities: entity.DefaultRegistry}.New()
+	defer w.Close()
+	pos := cube.Pos{0, 1, 0}
+	w.Do(func(tx *world.Tx) {
+		tx.SetBlock(cube.Pos{0, 1, 1}, block.Stone{}, nil)
+		tx.SetBlock(pos, mapFrame(900042), nil)
+	})
+	b, err := world.Call(context.Background(), w, func(tx *world.Tx) (world.Block, error) { return tx.Block(pos), nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, ok := b.(block.ItemFrame)
+	if !ok {
+		t.Fatalf("got %T", b)
+	}
+	if !f.Map {
+		t.Fatal("Map flag lost when reading frame back from world")
+	}
+
+	// Disk encoding through real NBT bytes, then decode as chunk loading does.
+	data := mapFrame(900042).EncodeNBT()
+	raw, err := nbt.MarshalEncoding(data, nbt.LittleEndian)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var back map[string]any
+	if err := nbt.UnmarshalEncoding(raw, &back, nbt.LittleEndian); err != nil {
+		t.Fatal(err)
+	}
+	got := (block.ItemFrame{}).DecodeNBT(back).(block.ItemFrame)
+	m, ok := got.Item.Item().(item.FilledMap)
+	if !ok || m.ID != 900042 || !got.Map {
+		t.Fatalf("decoded frame wrong: %#v (item %#v)", got, got.Item.Item())
+	}
+
+	// Network encoding of the held item stack (what the client sees in the item tag).
+	net := item.WriteNBT(item.NewStack(item.FilledMap{ID: 900042}, 1), false)
+	if v, ok := net["map_uuid"].(int64); !ok || v != 900042 {
+		t.Fatalf("network tag map_uuid = %#v", net["map_uuid"])
+	}
+}
+
+func TestMapPacketRoundTrip(t *testing.T) {
+	px := make([]color.RGBA, 128*128)
+	for i := range px {
+		px[i] = color.RGBA{R: uint8(i), G: 7, B: 9, A: 255}
+	}
+	pk := &packet.ClientBoundMapItemData{
+		MapID:          900042,
+		Scale:          protocol.Option[byte](0),
+		MapsIncludedIn: protocol.Option([]int64{900042}),
+		Width:          protocol.Option[int32](128),
+		Height:         protocol.Option[int32](128),
+		XOffset:        protocol.Option[int32](0),
+		YOffset:        protocol.Option[int32](0),
+		Pixels:         protocol.Option(px),
+	}
+	buf := new(bytes.Buffer)
+	pk.Marshal(protocol.NewWriter(buf, 0))
+	t.Logf("encoded packet size: %d bytes", buf.Len())
+	var out packet.ClientBoundMapItemData
+	out.Marshal(protocol.NewReader(buf, 0, false))
+	p, ok := out.Pixels.Value()
+	if !ok || len(p) != 128*128 || p[5] != px[5] || p[16383] != px[16383] || out.MapID != 900042 {
+		t.Fatalf("round trip mismatch (ok=%v len=%d id=%d)", ok, len(p), out.MapID)
+	}
+}
